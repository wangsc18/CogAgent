# ============================================
# PACE 系统环境配置示例
# ============================================

# ===== LLM API 配置（必需） =====
# Google Gemini API Key（推荐）
GOOGLE_API_KEY=your_google_api_key_here

# 或者使用 OpenAI 兼容的第三方 API
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.your-provider.com/v1

# ===== 实验配置（用于对比实验） =====
# EXPERIMENT_MODE: 实验模式选择
# - "experimental" (默认): 实验组 - 使用动态规则 + 认知效益分析
# - "baseline": 对照组 - 使用固定规则 + 通用帮助
EXPERIMENT_MODE=baseline

# PROACTIVE_DECISION_MODE: 主动服务决策模式
# - "heuristic" (推荐): 启发式规则决策（快速、低成本）
# - "llm": 使用LLM进行认知状态推理（准确但成本高）
PROACTIVE_DECISION_MODE=heuristic

# ===== MCP 工具配置（可选） =====
# GitHub Token（用于 GitHub MCP 工具）
# GITHUB_TOKEN=ghp_xxx

# ===== 其他配置 =====
# 日志级别（可选）
# LOG_LEVEL=INFO

# ============================================
# 实验模式说明
# ============================================
#
# 【实验组模式】EXPERIMENT_MODE=experimental
# 核心创新点：
# 1. 动态规则学习：规划脑根据用户反馈自动调整权重和阈值
# 2. 认知效益分析：基于卸载效益-交互成本模型生成个性化帮助
# 3. 战略意图分析：深度理解用户长期意图，指导主动服务方向
#
# 【对照组模式】EXPERIMENT_MODE=baseline
# 特点：
# 1. 固定规则参数：权重和阈值保持不变（不动态学习）
# 2. 通用帮助内容：使用固定的帮助模板（无个性化）
# 3. 简单二元决策：仅判断是否需要干预（无深度分析）
#
# 用途：
# 通过对比实验验证动态规则和认知效益策略的实际效果
# ============================================
